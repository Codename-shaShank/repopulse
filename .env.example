# Backend configuration. Copy to backend/.env and fill in real values.

# Supabase connection string (Project settings -> Database -> Connection string -> URI).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# Optional. Raises the GitHub API rate limit. A fine-grained token with public
# read access is enough. Never expose this to the frontend.
GITHUB_TOKEN=

# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:5173
